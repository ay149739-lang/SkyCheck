# ================================================================
# SkyCheck / AirGuard AI – Environment Variables Template
# Copy this file to .env in the project root and fill in values.
# Real credentials should NEVER be committed to version control.
# ================================================================

# 1. Google Air Quality API (Optional)
# If left empty, SkyCheck automatically uses the free global Open-Meteo
# atmospheric station and reanalysis monitoring network.
GOOGLE_AIR_QUALITY_API_KEY=

# 2. SMTP Mail Provider (Optional for testing, required for live email delivery)
# Supported: Gmail (with App Password), Outlook, SendGrid, Amazon SES, Mailgun, Brevo, etc.
# When unconfigured, SkyCheck runs safely in Development Test Mode (Mock Dispatch)
# with full validation, reference tracking, and SQLite audit logging.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# 3. Application Settings
CACHE_TTL_SECONDS=300
